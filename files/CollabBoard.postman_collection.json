{
  "info": {
    "name": "CollabBoard (SyncBoard) API",
    "description": "REST API for CollabBoard / SyncBoard — Working REST API with in-memory data, integrated with the React frontend. Covers auth, boards, tasks, and user profiles (bio + avatar upload).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "boardId", "value": "b1", "type": "string" },
    { "key": "newBoardId", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Student\",\n  \"email\": \"jane.student@collabboard.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates a new user. Returns { user, token }. password must be >= 8 chars; email must be unique."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@collabboard.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in with the seeded demo user. Returns { user, token }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the logged-in user for the given token. Requires auth."
          }
        }
      ]
    },
    {
      "name": "Boards",
      "item": [
        {
          "name": "List Boards",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/boards",
              "host": ["{{baseUrl}}"],
              "path": ["boards"]
            },
            "description": "Returns all boards. Requires auth."
          }
        },
        {
          "name": "Create Board",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Sprint Board\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/boards",
              "host": ["{{baseUrl}}"],
              "path": ["boards"]
            },
            "description": "Creates a board. Requires auth. Stores the new id in {{newBoardId}} (kept separate from {{boardId}}, which stays pointed at the seeded demo board used by the Tasks folder)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('newBoardId', body.board.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Board",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Renamed Board\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/boards/{{newBoardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{newBoardId}}"]
            },
            "description": "Renames the board created above. Run 'Create Board' first. Requires auth."
          }
        },
        {
          "name": "Delete Board",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/boards/{{newBoardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{newBoardId}}"]
            },
            "description": "Deletes the board created above (and its tasks). Run 'Create Board' first. Requires auth. Returns 204."
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks (all)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Returns every task across all boards. Requires auth."
          }
        },
        {
          "name": "List Tasks (by board)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks?boardId={{boardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [{ "key": "boardId", "value": "{{boardId}}" }]
            },
            "description": "Returns tasks filtered by boardId. Requires auth."
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"boardId\": \"{{boardId}}\",\n  \"title\": \"Write API tests\",\n  \"description\": \"Add Jest + Supertest coverage\",\n  \"status\": \"todo\",\n  \"assignedTo\": \"Jane\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Creates a task on a board. status must be one of todo | doing | done. Requires auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('taskId', body.task.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task (move / edit)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"doing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Updates any subset of { title, description, status, assignedTo }. Requires auth."
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Deletes a task by id. Requires auth. Returns 204."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Returns the logged-in user's profile, including bio and avatarUrl. Requires auth."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Silva\",\n  \"bio\": \"Full-stack student developer.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Updates name and/or bio for the logged-in user. Requires auth."
          }
        },
        {
          "name": "Upload My Avatar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": [],
                  "description": "PNG, JPEG, or WEBP image, max 3MB."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "avatar"]
            },
            "description": "Uploads/replaces the logged-in user's profile photo. Field name must be 'avatar'. Requires auth. In the Postman app, click into the 'avatar' form field and pick a local image file before sending - this cannot be automated from a plain JSON collection import."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "No auth required. Returns { status: \"ok\" } if the server is up."
          }
        }
      ]
    }
  ]
}
